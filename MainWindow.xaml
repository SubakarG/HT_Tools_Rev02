<Window x:Class="HelmertLSA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helmert 3D LSA Tool" Height="400" Width="800" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,10">
            <TextBlock Text="Master File:" Width="100" VerticalAlignment="Center" />
            <TextBox x:Name="MasterFileBox" Width="400" Margin="5,0" />
            <Button Content="Browse" Click="BrowseMaster_Click" Width="98" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,10,0,10">
            <TextBlock Text="Adjustable File:" Width="100" VerticalAlignment="Center" />
            <TextBox x:Name="AdjustFileBox" Width="400" Margin="5,0" />
            <Button Content="Browse" Click="BrowseAdjustable_Click" Width="96" />
        </StackPanel>

        <DataGrid x:Name="FilePreviewGrid" Grid.Row="2" Margin="10,23,0,94" AutoGenerateColumns="True" />

        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Center" Margin="10">
            <Button Content="Run Adjustment" Width="150" Click="RunAdjustment_Click" Margin="5"/>
            <Button Content="Visualize Data" Width="150" Click="VisualizeData_Click" Margin="5"/>
            <Button Content="Toggle Theme" Width="150" Click="ToggleTheme_Click" Margin="5"/>
        </StackPanel>

        <ProgressBar x:Name="ProgressBar" Grid.Row="4" Height="20" Margin="5" Visibility="Collapsed" />
    </Grid>
</Window>