<Window x:Class="HelmertLSA.ResidualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Residuals" Height="600" Width="800" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid x:Name="ResidualsGrid" AutoGenerateColumns="False" IsReadOnly="False" Grid.Row="0" Margin="10,10,10,0" SelectionMode="Extended" Height="337" VerticalAlignment="Top">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Point ID" Binding="{Binding PointID}" Width="*" />
                <DataGridTextColumn Header="dX" Binding="{Binding dX}" Width="*" />
                <DataGridTextColumn Header="dY" Binding="{Binding dY}" Width="*" />
                <DataGridTextColumn Header="dZ" Binding="{Binding dZ}" Width="*" />
                <DataGridTextColumn Header="Magnitude" Binding="{Binding VectorLength}" Width="*" />
                <DataGridCheckBoxColumn Header="Remove" Binding="{Binding IsSelected, Mode=TwoWay}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Vertical" Grid.Row="1" Margin="10">
            <TextBlock x:Name="TransformationDetails" TextWrapping="Wrap" Height="47" />
            <TextBlock x:Name="StatisticsDetails" TextWrapping="Wrap" Margin="10,5,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="10">
            <Button Content="Undo" Width="100" Margin="5" Click="Undo_Click" />
            <Button Content="Redo" Width="100" Margin="5" Click="Redo_Click" />
            <Button Content="Recalculate" Width="100" Margin="5" Click="Recalculate_Click" />
            <Button Content="Accept" Width="100" Margin="5" Click="Accept_Click" />
            <Button Content="Cancel" Width="100" Margin="5" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>